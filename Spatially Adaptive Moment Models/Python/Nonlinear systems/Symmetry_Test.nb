     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Power(\>\"", "->", "\"\<(\>\""}], ",", 
       RowBox[{"\"\<,2)\>\"", "->", "\"\<)**2\>\""}], ",", 
       RowBox[{"\"\<Sqrt\>\"", "->", "\"\<np.sqrt\>\""}], ",", 
       RowBox[{"\"\<List(List(\>\"", "->", "\"\<A[] = \>\""}], ",", 
       RowBox[{"\"\<),List(\>\"", "->", "\"\<\\nA[] = \>\""}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "0"}], ",", 
    RowBox[{"i", " ", "<", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"K", "+", "1"}], ")"}]}]}], ",", 
