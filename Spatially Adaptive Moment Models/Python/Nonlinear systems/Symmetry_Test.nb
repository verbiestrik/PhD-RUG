Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"distribution", "==", "\"\<Normal\>\""}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Ak", " ", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", 
          SqrtBox["k"]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "K"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Bk", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         SqrtBox[
          RowBox[{"k", "+", "1"}]], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "K"}], "}"}]}], "]"}]}], ";"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"distribution", "==", "\"\<Uniform\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Ak", " ", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["k", 
             SqrtBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", "*", "k"}], "-", "1"}], ")"}], "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", "*", "k"}], "+", "1"}], ")"}]}]]]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "K"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Bk", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"k", "+", "1"}], 
            SqrtBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", "k"}], "+", "1"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", "k"}], "+", "3"}], ")"}]}]]], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "K"}], "}"}]}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
       "Print", 
        "[", "\"\<Not a Valid Distribution, choose Normal or Uniform\>\"", 
        "]"}]}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", " ", "[", 
