Cell[BoxData["\<\"S[0] = 0\\nS[1] = 0\\nS[2] = 0\\nS[3] = (-3*(35*(h0)**2*q0 \
+ 4*(-7*(h1)**2 + 5*(h2)**2)*q0 + h0*(24*np.sqrt(5)*h2*q0 - 35*h1*q1 - \
35*h2*q2) + 2*np.sqrt(5)*(2*h1*h2*q1 + 7*(h1)**2*q2 - 7*(h2)**2*q2))*mu + \
np.sqrt(3)*(35*h0*h1*q0 - 35*(h0)**2*q1 + h2*(-4*np.sqrt(5)*h1*q0 + 35*h2*q1 \
- 35*h1*q2) + 2*np.sqrt(5)*h0*(-5*h2*q1 + 7*h1*q2))*sigma)/(3.*(35*(h0,3) + \
24*np.sqrt(5)*(h0)**2*h2 + 2*np.sqrt(5)*h2*(9*(h1)**2 - 7*(h2)**2) - \
3*h0*(21*(h1)**2 + 5*(h2)**2))*slip_length)\\nS[4] = (-3*(-35*h0*h1*q0 + \
35*(h0)**2*q1 + 2*np.sqrt(5)*h0*(5*h2*q1 - 7*h1*q2) + h2*(4*np.sqrt(5)*h1*q0 \
- 35*h2*q1 + 35*h1*q2))*mu + np.sqrt(3)*(-7*(h0)**2*(5*q0 + 2*np.sqrt(5)*q2) \
+ h0*(-10*np.sqrt(5)*h2*q0 + 63*h1*q1 + 7*h2*q2) + 2*h2*(4*h2*q0 + \
np.sqrt(5)*(-9*h1*q1 + 7*h2*q2)))*sigma)/(3.*(35*(h0,3) + \
24*np.sqrt(5)*(h0)**2*h2 + 2*np.sqrt(5)*h2*(9*(h1)**2 - 7*(h2)**2) - \
3*h0*(21*(h1)**2 + 5*(h2)**2))*slip_length)\\nS[5] = (21*(h1*(2*np.sqrt(5)*h0 \
- 5*h2)*q1 + (h1)**2*(-2*np.sqrt(5)*q0 + 5*q2) + (5*h0 + \
2*np.sqrt(5)*h2)*(h2*q0 - h0*q2))*mu - 2*np.sqrt(3)*(4*h1*h2*q0 + \
7*np.sqrt(5)*(h0)**2*q1 + 10*h0*h2*q1 - 7*h0*h1*(np.sqrt(5)*q0 + 2*q2) + \
7*np.sqrt(5)*h2*(-(h2*q1) + h1*q2))*sigma)/(3.*(35*(h0,3) + \
24*np.sqrt(5)*(h0)**2*h2 + 2*np.sqrt(5)*h2*(9*(h1)**2 - 7*(h2)**2) - \
3*h0*(21*(h1)**2 + 5*(h2)**2))*slip_length)))\"\>"], "Output",
