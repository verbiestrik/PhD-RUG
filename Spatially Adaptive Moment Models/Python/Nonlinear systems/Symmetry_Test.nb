Cell[BoxData[
 RowBox[{
  RowBox[{"FluxPrim", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"FluxPMPrim", " ", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"hp", "\[Rule]", " ", 
          RowBox[{"h0", "+", " ", "h1"}]}], ",", 
         RowBox[{"hm", "\[Rule]", " ", 
          RowBox[{"h0", "-", " ", "h1"}]}], ",", 
         RowBox[{"up", "\[Rule]", " ", 
          RowBox[{"u0", "+", " ", "u1"}]}], ",", 
         RowBox[{"um", " ", "->", " ", 
          RowBox[{"u0", "-", " ", "u1"}]}], ",", 
         RowBox[{"ap", "\[Rule]", " ", 
          RowBox[{"a0", "+", " ", "a1"}]}], ",", 
         RowBox[{"am", "\[Rule]", " ", 
          RowBox[{"a0", "-", " ", "a1"}]}]}], "}"}]}], "//", "Simplify"}], "//",
      "FullSimplify"}], "//", "Expand"}]}], ";", " ", 
  RowBox[{"Print", "[", 
   RowBox[{"FluxPrim", "//", "MatrixForm"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9702263135820837`*^9, 3.970226430224638*^9}, {
