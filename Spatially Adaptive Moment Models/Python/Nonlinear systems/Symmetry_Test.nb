     RowBox[{
      RowBox[{"OutputPythonElements", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"k", "++"}], ",", "1"}], "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{"Flux", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "[", 
       RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OutputPython", " ", "=", " ", 
