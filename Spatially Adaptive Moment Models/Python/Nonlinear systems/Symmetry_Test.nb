Cell[BoxData["\<\"J[0][0] = 0\\nJ[0][1] = 0\\nJ[0][2] = 1\\nJ[0][3] = \
0\\nJ[1][0] = 0\\nJ[1][1] = 0\\nJ[1][2] = 0\\nJ[1][3] = 1\\nJ[2][0] = g*h0 - \
(-((h1*q0)/((h0)**2 - (h1)**2)) + (h0*q1)/((h0)**2 - (h1)**2))**2 - \
((h0*q0)/((h0)**2 - (h1)**2) - (h1*q1)/((h0)**2 - (h1)**2))**2\\nJ[2][1] = \
g*h1 - 2*(-((h1*q0)/((h0)**2 - (h1)**2)) + (h0*q1)/((h0)**2 - \
(h1)**2))*((h0*q0)/((h0)**2 - (h1)**2) - (h1*q1)/((h0)**2 - \
(h1)**2))\\nJ[2][2] = (2*h0*q0)/((h0)**2 - (h1)**2) - (2*h1*q1)/((h0)**2 - \
(h1)**2)\\nJ[2][3] = (-2*h1*q0)/((h0)**2 - (h1)**2) + (2*h0*q1)/((h0)**2 - \
(h1)**2)\\nJ[3][0] = g*h1 - 2*(-((h1*q0)/((h0)**2 - (h1)**2)) + \
(h0*q1)/((h0)**2 - (h1)**2))*((h0*q0)/((h0)**2 - (h1)**2) - (h1*q1)/((h0)**2 \
- (h1)**2))\\nJ[3][1] = g*h0 - (-((h1*q0)/((h0)**2 - (h1)**2)) + \
(h0*q1)/((h0)**2 - (h1)**2))**2 - ((h0*q0)/((h0)**2 - (h1)**2) - \
(h1*q1)/((h0)**2 - (h1)**2))**2\\nJ[3][2] = (-2*h1*q0)/((h0)**2 - (h1)**2) + \
(2*h0*q1)/((h0)**2 - (h1)**2)\\nJ[3][3] = (2*h0*q0)/((h0)**2 - (h1)**2) - \
(2*h1*q1)/((h0)**2 - (h1)**2)))\"\>"], "Output",
 CellChangeTimes->{3.9544952151321983`*^9, 3.9561262129802017`*^9, 
