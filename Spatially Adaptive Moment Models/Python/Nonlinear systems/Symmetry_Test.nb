          FractionBox[
           RowBox[{"h0", " ", "q1"}], 
           RowBox[{
            SuperscriptBox["h0", "2"], "-", 
            SuperscriptBox["h1", "2"]}]]}], ")"}], "2"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"h0", " ", "q0"}], 
           RowBox[{
            SuperscriptBox["h0", "2"], "-", 
