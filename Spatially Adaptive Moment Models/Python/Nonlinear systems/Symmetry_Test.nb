Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "0", "1", "0"},
     {"0", "0", "0", "1"},
     {
      FractionBox[
       RowBox[{
        RowBox[{"g", " ", "h0", " ", 
         SuperscriptBox[
          RowBox[{"(", 
