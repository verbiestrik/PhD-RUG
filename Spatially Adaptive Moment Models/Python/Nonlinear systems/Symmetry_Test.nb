Cell[BoxData[{
 RowBox[{
  RowBox[{"Flux", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"K", "+", "1"}], ",", 
             RowBox[{"K", "+", "1"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{"K", "+", "1"}], "]"}], ",", "2"}], "]"}], ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"g", "*", "Ph"}], "-", 
          RowBox[{"Pq", ".", "Phinv", ".", "B"}]}], ",", 
         RowBox[{
          RowBox[{"Pq", ".", "Phinv"}], "+", "B"}], ",", "2"}], "]"}]}], 
      "]"}], "//", "Simplify"}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
