 RowBox[{
  RowBox[{"Flux", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"K", "+", "1"}], ",", 
             RowBox[{"K", "+", "1"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{"K", "+", "1"}], "]"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"K", "+", "1"}], ",", 
             RowBox[{"K", "+", "1"}]}], "}"}]}], "]"}], ",", "2"}], "]"}], ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"g", "*", "Ph"}], "-", 
          RowBox[{"Pq", ".", "Phinv", ".", "B"}], "-", 
          RowBox[{
           FractionBox["1", "3"], 
           RowBox[{"Pr", ".", "Phinv", ".", "A"}]}]}], ",", 
         RowBox[{
          RowBox[{"Pq", ".", "Phinv"}], "+", "B"}], ",", 
         RowBox[{
          FractionBox["1", "3"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Pr", ".", "Phinv"}], "+", "A"}], ")"}]}], ",", "2"}], 
        "]"}], ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Pq", ".", "Phinv", ".", "A"}]}], "-", 
          RowBox[{"Pr", ".", "Phinv", ".", "B"}]}], ",", 
         RowBox[{
          RowBox[{"Pr", ".", "Phinv"}], "+", "A"}], ",", 
         RowBox[{"Pq", ".", "Phinv"}], ",", "2"}], "]"}]}], "]"}], "//", 
     "Simplify"}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
