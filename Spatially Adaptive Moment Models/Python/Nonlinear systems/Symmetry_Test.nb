Cell[CellGroupData[{

Cell["Shallow Water Linearised Moment Equations (N=2)", "Section",
 CellChangeTimes->{{3.985935899906303*^9, 
  3.985935937278308*^9}},ExpressionUUID->"8a96aee9-34c8-4fde-b15f-\
bfac5624e523"],

Cell[CellGroupData[{

Cell["Defining the vectors & matrices", "Subsection",
 CellChangeTimes->{{3.985935945511983*^9, 
  3.9859359620795813`*^9}},ExpressionUUID->"c015d9b1-db01-4bca-8319-\
c90b2ad844f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Symbol", "[", 
       RowBox[{"\"\<h\>\"", "<>", 
        RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], ",", 
     RowBox[{"K", "+", "1"}], ",", "0"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"q", "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Symbol", "[", 
       RowBox[{"\"\<q\>\"", "<>", 
        RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], ",", 
     RowBox[{"K", "+", "1"}], ",", "0"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Symbol", "[", 
       RowBox[{"\"\<r\>\"", "<>", 
        RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], ",", 
     RowBox[{"K", "+", "1"}], ",", "0"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"s", "=", 
    RowBox[{"Array", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Symbol", "[", 
        RowBox[{"\"\<s\>\"", "<>", 
         RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], ",", 
      RowBox[{"K", "+", "1"}], ",", "0"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BasisFn", "[", 
             RowBox[{"k", ",", "y"}], "]"}], "*", 
            RowBox[{"BasisFn", "[", 
             RowBox[{"l", ",", "y"}], "]"}], "*", 
            RowBox[{"BasisFn", "[", 
             RowBox[{"m", ",", "y"}], "]"}], "*", 
            RowBox[{"w", "[", "y", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"Boundary", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"Boundary", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", "K"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "0", ",", "K"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "K"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ph", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"[", 
        RowBox[{"i", "+", "1"}], "]"}], "]"}], "*", 
      RowBox[{"M", "[", 
       RowBox[{"[", 
        RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "K"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pq", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"q", "[", 
       RowBox[{"[", 
        RowBox[{"i", "+", "1"}], "]"}], "]"}], "*", 
      RowBox[{"M", "[", 
       RowBox[{"[", 
        RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "K"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pr", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"r", "[", 
       RowBox[{"[", 
        RowBox[{"i", "+", "1"}], "]"}], "]"}], "*", 
      RowBox[{"M", "[", 
       RowBox[{"[", 
        RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "K"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ps", "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"s", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}], "*", 
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "K"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Phinv", "=", 
   RowBox[{"Inverse", "[", "Ph", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Btemp", "=", 
   RowBox[{"Phinv", ".", "q"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Atemp", "=", 
   RowBox[{"Phinv", ".", "r"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
