Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"distribution", "==", "\"\<Normal\>\""}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"BasisFn", "[", 
       RowBox[{"n_", ",", "y_"}], "]"}], ":=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "n"}], "/", "2"}], ")"}]}], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"n", "!"}], "]"}]}], "*", 
        RowBox[{"HermiteH", "[", 
         RowBox[{"n", ",", 
          RowBox[{"y", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Probabilist", " ", "Hermite", " ", "Polynomials"}], ",", " ", 
       RowBox[{
       "to", " ", "be", " ", "used", " ", "for", " ", "Normal", " ", 
        "Distribution"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"w", "[", "y_", "]"}], ":=", 
      RowBox[{
       FractionBox["1", 
        SqrtBox[
         RowBox[{"2", "\[Pi]"}]]], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"y", "^", "2"}]}], "/", "2"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Boundary", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], ";"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"distribution", "==", "\"\<Uniform\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"BasisFn", "[", 
         RowBox[{"n_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "n"}], "+", "1"}], ")"}], "]"}], "*", 
         RowBox[{"LegendreP", "[", 
          RowBox[{"n", ",", "y"}], "]"}]}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Legendre", " ", "Polynomials"}], ",", " ", 
         RowBox[{
         "to", " ", "be", " ", "used", " ", "for", " ", "Uniform", " ", 
          "Distribution"}]}], "*)"}], "\n", "     ", 
       RowBox[{
        RowBox[{"w", "[", "y_", "]"}], " ", ":=", 
        RowBox[{"1", "/", "2"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Boundary", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<Not a Valid Distribution, choose Normal or Uniform\>\
\"", "]"}]}], "]"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9380755718232536`*^9, 3.938075715383753*^9}, {
   3.9380757872997627`*^9, 3.938075809757162*^9}, {3.9380764414292793`*^9, 
