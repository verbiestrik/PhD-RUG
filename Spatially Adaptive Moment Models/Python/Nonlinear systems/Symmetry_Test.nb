Cell[BoxData["\<\"A[0][0] = 0\\nA[0][1] = 0\\nA[0][2] = 1\\nA[0][3] = \
0\\nA[1][0] = 0\\nA[1][1] = 0\\nA[1][2] = 0\\nA[1][3] = 1\\nA[2][0] = \
(g*h0*((h0)**2 - (h1)**2)**2 + 4*h0*h1*q0*q1 - (h0)**2*((q0)**2 + (q1)**2) - \
(h1)**2*((q0)**2 + (q1)**2))/((h0)**2 - (h1)**2)**2\\nA[2][1] = g*h1 + \
(2*(h1*q0 - h0*q1)*(h0*q0 - h1*q1))/((h0)**2 - (h1)**2)**2\\nA[2][2] = \
(2*h0*q0 - 2*h1*q1)/((h0)**2 - (h1)**2)\\nA[2][3] = (2*(-(h1*q0) + \
h0*q1))/((h0)**2 - (h1)**2)\\nA[3][0] = g*h1 + (2*(h1*q0 - h0*q1)*(h0*q0 - \
h1*q1))/((h0)**2 - (h1)**2)**2\\nA[3][1] = (g*h0*((h0)**2 - (h1)**2)**2 + \
4*h0*h1*q0*q1 - (h0)**2*((q0)**2 + (q1)**2) - (h1)**2*((q0)**2 + \
(q1)**2))/((h0)**2 - (h1)**2)**2\\nA[3][2] = (2*(-(h1*q0) + h0*q1))/((h0)**2 \
- (h1)**2)\\nA[3][3] = (2*h0*q0 - 2*h1*q1)/((h0)**2 - (h1)**2)))\"\>"], \
"Output",
 CellChangeTimes->{3.9544952151321983`*^9, 3.9561262129802017`*^9, 
