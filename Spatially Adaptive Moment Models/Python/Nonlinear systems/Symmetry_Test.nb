Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"NumberOfEntries", "=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"K", "+", "1"}], ")"}]}], ")"}], "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OutputPythonElements", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"NumberOfEntries", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{"2", "*", 
     RowBox[{"(", 
      RowBox[{"K", "+", "1"}], ")"}]}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", "1"}], ",", 
     RowBox[{"j", "<=", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"K", "+", "1"}], ")"}]}]}], ",", 
     RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"OutputPythonElements", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"k", "++"}], ",", "1"}], "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{"Flux", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "[", 
       RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OutputPython", " ", "=", " ", 
   RowBox[{"StringReplace", "[", 
    RowBox[{
     RowBox[{"ToString", "[", 
      RowBox[{"CForm", "[", "OutputPythonElements", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Power(\>\"", "->", "\"\<(\>\""}], ",", 
       RowBox[{"\"\<,2)\>\"", "->", "\"\<)**2\>\""}], ",", 
       RowBox[{"\"\<Sqrt\>\"", "->", "\"\<np.sqrt\>\""}], ",", 
       RowBox[{"\"\<List(List(\>\"", "->", "\"\<A[] = \>\""}], ",", 
       RowBox[{"\"\<),List(\>\"", "->", "\"\<\\nA[] = \>\""}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "0"}], ",", 
    RowBox[{"i", " ", "<", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"K", "+", "1"}], ")"}]}]}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "0"}], ",", 
      RowBox[{"j", "<", 
       RowBox[{"2", "*", 
        RowBox[{"(", 
         RowBox[{"K", "+", "1"}], ")"}]}]}], ",", 
      RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{"OutputPython", "=", 
       RowBox[{"StringInsert", "[", 
        RowBox[{"OutputPython", ",", 
         RowBox[{"StringJoin", "[", 
          RowBox[{
           RowBox[{"ToString", "[", "i", "]"}], ",", "\"\<][\>\"", ",", 
           RowBox[{"ToString", "[", "j", "]"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"StringPosition", "[", 
           RowBox[{"OutputPython", ",", "\"\<A[]\>\"", ",", "1"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}],
   ";"}], "\[IndentingNewLine]", "OutputPython"}], "Input",
 CellChangeTimes->{{3.9815370636992292`*^9, 3.9815370948010893`*^9}, 
