                RowBox[{"2", "*", "k"}], "+", "3"}], ")"}]}]]], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "K"}], "}"}]}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
       "Print", 
        "[", "\"\<Not a Valid Distribution, choose Normal or Uniform\>\"", 
