Cell["Calculating the flux matrix", "Subsection",
 CellChangeTimes->{{3.985936121416006*^9, 
  3.985936150162266*^9}},ExpressionUUID->"d956aa31-2023-4389-b106-\
a9447ea3c779"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Flux", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
