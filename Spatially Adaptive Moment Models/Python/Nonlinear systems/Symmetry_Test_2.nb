 RowBox[{"     ", 
  RowBox[{
   RowBox[{
    RowBox[{"w", "[", "y_", "]"}], " ", ":=", 
    FractionBox["1", "2"]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Boundary", "=", 
