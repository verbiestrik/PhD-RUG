    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "k"}], "+", "1"}], ")"}]}], 
     RowBox[{"3", "*", 
      SuperscriptBox["k", "2"]}]]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "[", "k_", "]"}], ":=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", "k_", "]"}], ":=", 
   RowBox[{
    FractionBox[
