          RowBox[{"Pq", ".", "Phinv", ".", "B"}], "-", 
          RowBox[{
           FractionBox["1", "3"], 
           RowBox[{"Pr", ".", "Phinv", ".", "A"}]}]}], ",", 
         RowBox[{
          RowBox[{"Pq", ".", "Phinv"}], "+", "B"}], ",", 
