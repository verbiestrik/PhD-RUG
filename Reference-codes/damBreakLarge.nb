                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
                  RowBox[{
                   RowBox[{"j", "-", "i"}], "\[Equal]", "1"}]}], 
                 "\[RuleDelayed]", 
