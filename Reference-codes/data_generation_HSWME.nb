      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Differences", "[", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "dx"]}], 
           RowBox[{"Table", "[", 
