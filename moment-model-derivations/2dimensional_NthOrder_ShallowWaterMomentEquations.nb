Cell[BoxData["\<\"sourceTerm(0)=-((h*ur)/coords(0));\\nsourceTerm(1)=-((R*(ur \
+ alphas[1] + alphas[2] + alphas[3]))/xi) - (h*(pow(ur,2) - pow(utheta,2) + \
pow(alphas[1],2)/3. + pow(alphas[2],2)/5. + pow(alphas[3],2)/7. - \
pow(gammas[1],2)/3. - pow(gammas[2],2)/5. - \
pow(gammas[3],2)/7.))/coords(0);\\nsourceTerm(2)=(-3*R*(ur + (1 + \
(4*xi)/h)*alphas[1] + alphas[2] + (1 + (4*xi)/h)*alphas[3]))/xi + \
(h*(-7*alphas[1]*(5*ur + 4*alphas[2]) + 2*(-9*alphas[2]*alphas[3] + \
7*gammas[1]*(5*utheta + 2*gammas[2]) + \
9*gammas[2]*gammas[3])))/(35.*coords(0));\\nsourceTerm(3)=(-5*R*(ur + \
alphas[1] + (1 + (12*xi)/h)*alphas[2] + alphas[3]))/xi + \
(h*(7*pow(alphas[1],2) - 3*alphas[2]*(7*ur + alphas[2]) - \
21*alphas[1]*alphas[3] - 3*pow(alphas[3],2) + 6*gammas[2]*(7*utheta + \
gammas[2]) + 2*(gammas[1] + gammas[3])*(7*gammas[1] + \
2*gammas[3])))/(21.*coords(0));\\nsourceTerm(4)=(-7*R*(ur + (1 + \
(4*xi)/h)*alphas[1] + alphas[2] + (1 + (24*xi)/h)*alphas[3]))/xi + \
(h*(12*alphas[1]*alphas[2] - 3*(5*ur + alphas[2])*alphas[3] + \
30*utheta*gammas[3] + 2*gammas[2]*(9*gammas[1] + \
4*gammas[3])))/(15.*coords(0));\\nsourceTerm(5)=-((R*(utheta + gammas[1] + \
gammas[2] + gammas[3]))/xi) - (2*h*(ur*utheta + (alphas[1]*gammas[1])/3. + \
(alphas[2]*gammas[2])/5. + \
(alphas[3]*gammas[3])/7.))/coords(0);\\nsourceTerm(6)=(-3*R*(utheta + (1 + \
(4*xi)/h)*gammas[1] + gammas[2] + (1 + (4*xi)/h)*gammas[3]))/xi - (h*((2*ur + \
(3*alphas[2])/5.)*gammas[1] + (3*alphas[3]*gammas[2])/7. + alphas[1]*(utheta \
+ gammas[2]) + \
(3*alphas[2]*gammas[3])/5.))/coords(0);\\nsourceTerm(7)=(-5*R*(utheta + \
gammas[1] + (1 + (12*xi)/h)*gammas[2] + gammas[3]))/xi - (h*(42*ur*gammas[2] \
+ 3*alphas[2]*(7*utheta + 3*gammas[2]) + alphas[3]*(12*gammas[1] + \
7*gammas[3]) + alphas[1]*(7*gammas[1] + \
27*gammas[3])))/(21.*coords(0));\\nsourceTerm(8)=(-7*R*(utheta + (1 + \
(4*xi)/h)*gammas[1] + gammas[2] + (1 + (24*xi)/h)*gammas[3]))/xi - \
(h*(5*alphas[3]*(3*utheta + gammas[2]) + 30*ur*gammas[3] + \
6*alphas[2]*(gammas[1] + gammas[3])))/(15.*coords(0))))\"\>"], "Output",
 CellChangeTimes->{3.9080102846426263`*^9, 3.90802313814642*^9, 
  3.9114633373213077`*^9, 3.9123327000520573`*^9},
 CellLabel->"Out[78]=",ExpressionUUID->"bb72bf9f-16ac-4dee-a108-6eee357d0dc3"]
