Cell[CellGroupData[{

Cell["Hyperbolicity plot of the (4,4)th order system", "Subsection",
 CellChangeTimes->{{3.8489918165558395`*^9, 
  3.848991827586138*^9}},ExpressionUUID->"2a734ec8-88bc-42e9-aac9-\
18c4690f57e7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], ":=", 
   RowBox[{
    RowBox[{"CharPol2", "[", "\[Lambda]", "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"2", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "->", 
       "0"}], ",", 
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"3", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "->", 
       "0"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EVs", "[", 
    RowBox[{"alpha1_", ",", "alpha4_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], "\[Equal]", "0"}], ",", 
      "\[Lambda]"}], "]"}], " ", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"1", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "\[Rule]", 
       "alpha1"}], ",", 
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"4", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "->", 
       "alpha4"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ImaginaryPartofEV", "[", 
    RowBox[{"alpha1_", ",", "alpha4_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Im", "[", "\[Lambda]", "]"}], "   ", "/.", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], "\[Equal]", "0"}], ",", 
       "\[Lambda]"}], "]"}]}], " ", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"1", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "\[Rule]", 
       "alpha1"}], ",", 
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"4", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "\[Rule]", 
       "alpha4"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HypTest", "[", 
    RowBox[{"alpha1_", ",", "alpha4_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"HypTest", "[", 
     RowBox[{"alpha1", ",", "alpha4"}], "]"}], "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Chop", "[", 
        RowBox[{"Norm", "[", 
         RowBox[{"Chop", "[", 
          RowBox[{"N", "[", 
           RowBox[{"Chop", "[", 
            RowBox[{"ImaginaryPartofEV", "[", 
             RowBox[{"alpha1", ",", "alpha4"}], "]"}], "]"}], "]"}], "]"}], 
         "]"}], "]"}], "\[Equal]", "0"}], ",", "0", ",", "10"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"HypRegion", " ", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"HypTest", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"PlotPoints", "\[Rule]", "10"}], ",", 
     RowBox[{"MaxRecursion", "\[Rule]", "2"}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", 
      RowBox[{"0.25", "/", "0.4"}]}], ",", 
     RowBox[{"ColorFunction", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#1", "<", 
           RowBox[{"1", "/", "2"}]}], ",", "White", " ", ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"1.0", ",", "0.0", ",", "0.0"}], "]"}]}], "]"}], "&"}], 
       ")"}]}], ",", 
     RowBox[{"Frame", "\[Rule]", "False"}], ",", 
     RowBox[{"Axes", "\[Rule]", "True"}], ",", 
     RowBox[{"AxesOrigin", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Ticks", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.2"}], ",", 
            RowBox[{"-", "0.1"}], ",", "0.0", ",", "0.1", ",", "0.2"}], "}"}],
           ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.2"}], ",", 
            RowBox[{"-", "0.1"}], ",", "0.0", ",", "0.1", ",", "0.2"}], 
           "}"}]}], "}"}]}], ","}], "*)"}], 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"alpha1", "/", 
           SqrtBox["gh"]}], ",", "Small", ",", "Bold"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"alpha4", "/", 
           SqrtBox["gh"]}], ",", "Small", ",", "Bold"}], "]"}]}], "}"}]}], 
     ",", 
     RowBox[{"AxesStyle", "\[Rule]", "Thick"}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Bold", ",", "Medium"}], "}"}]}]}], "]"}]}],
  FontWeight->"Bold"]}], "Input",
