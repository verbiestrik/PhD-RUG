       "alpha4"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HypTest", "[", 
    RowBox[{"alpha1_", ",", "alpha4_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"HypTest", "[", 
     RowBox[{"alpha1", ",", "alpha4"}], "]"}], "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Chop", "[", 
