                RowBox[{"h", "[", 
                 RowBox[{"t", ",", "r", ",", "\[Theta]"}], "]"}]}], "]"}], 
              "*", "\[Lambda]"}], " ", "+", 
             RowBox[{"vr", "[", 
              RowBox[{"t", ",", "r", ",", "\[Theta]"}], "]"}]}], ")"}]}], ",", 
          RowBox[{
           RowBox[{"alphas", "[", 
