          RowBox[{"gammas", "[", 
           RowBox[{"i", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}]}], 
         RowBox[{
          RowBox[{"2", "*", "i"}], "+", "1"}]], ",", 
