Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vars", "[", 
    RowBox[{"t_", ",", "x_", ",", "y_"}], "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<", 
     RowBox[{"Nx", "+", "1"}]}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{"AppendTo", "[", 
     RowBox[{
      RowBox[{"vars", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
      RowBox[{"alphas", "[", 
       RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}]}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AppendTo", "[", 
   RowBox[{
    RowBox[{"vars", "[", 
     RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
    RowBox[{"v", "[", 
     RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<", 
     RowBox[{"Ny", "+", "1"}]}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{"AppendTo", "[", 
