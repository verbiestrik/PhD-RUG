            RowBox[{"alphas", "[", 
             RowBox[{"1", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "*", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"g", "*", 
              RowBox[{"h", "[", 
               RowBox[{"t", ",", "r", ",", "\[Theta]"}], "]"}]}], "]"}]}]}]}],
          "}"}]}], "]"}], ",", "\[Lambda]"}], "]"}]}], ";"}], 
