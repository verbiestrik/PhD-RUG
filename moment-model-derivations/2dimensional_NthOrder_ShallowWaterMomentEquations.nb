Cell[CellGroupData[{

Cell["Source term", "Subsection",
 CellChangeTimes->{{3.8605669745703664`*^9, 
  3.8605669770423117`*^9}},ExpressionUUID->"03fb01ad-19ea-4937-a668-\
f8c1d381293f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sourceTerm", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"3", "+", "Nr", "+", "N\[Theta]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CCoefficients", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"LegendreP", "[", 
            RowBox[{"i", ",", 
             RowBox[{
              RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ",", "x"}], "]"}],
          "*", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"LegendreP", "[", 
            RowBox[{"j", ",", 
             RowBox[{
              RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ",", "x"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Max", "[", 
         RowBox[{"Nr", ",", "N\[Theta]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Max", "[", 
         RowBox[{"Nr", ",", "N\[Theta]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sourceTerm", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sourceTerm", "[", 
    RowBox[{"[", "2", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["\[Nu]", "\[Lambda]"]}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"vr", "[", 
       RowBox[{"t", ",", "r", ",", "\[Theta]"}], "]"}], "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"alphas", "[", 
         RowBox[{"i", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "Nr"}], "}"}]}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", " ", "<=", " ", "Nr"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sourceTerm", "[", 
      RowBox[{"[", 
       RowBox[{"2", "+", "i"}], "]"}], "]"}], "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "i"}], "+", "1"}], ")"}]}], 
      FractionBox["\[Nu]", "\[Lambda]"], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"vr", "[", 
         RowBox[{"t", ",", "r", ",", "\[Theta]"}], "]"}], "+", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              FractionBox["\[Lambda]", 
               RowBox[{"h", "[", 
                RowBox[{"t", ",", "r", ",", "\[Theta]"}], "]"}]], "*", 
              RowBox[{"CCoefficients", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], ")"}], "*", 
           RowBox[{"alphas", "[", 
            RowBox[{"j", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "Nr"}], "}"}]}], "]"}]}], ")"}]}]}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sourceTerm", "[", 
    RowBox[{"[", 
     RowBox[{"Nr", "+", "3"}], "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["\[Nu]", "\[Lambda]"]}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"v\[Theta]", "[", 
       RowBox[{"t", ",", "r", ",", "\[Theta]"}], "]"}], "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"gammas", "[", 
         RowBox[{"i", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "N\[Theta]"}], "}"}]}], "]"}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", " ", "<=", " ", "N\[Theta]"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sourceTerm", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "Nr", "+", "3"}], "]"}], "]"}], "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "i"}], "+", "1"}], ")"}]}], 
      FractionBox["\[Nu]", "\[Lambda]"], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"v\[Theta]", "[", 
         RowBox[{"t", ",", "r", ",", "\[Theta]"}], "]"}], "+", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              FractionBox["\[Lambda]", "h"], "*", 
              RowBox[{"CCoefficients", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], ")"}], "*", 
           RowBox[{"gammas", "[", 
            RowBox[{"j", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}]}], ",", 
