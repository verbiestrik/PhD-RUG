Cell[BoxData[{
 RowBox[{
  RowBox[{"Xflux", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"3", "+", "Nx", "+", "Ny"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Yflux", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"3", "+", "Nx", "+", "Ny"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Xflux", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
    RowBox[{"u", "[", 
     RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Xflux", "[", 
    RowBox[{"[", "2", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
     SuperscriptBox[
      RowBox[{"u", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], "2"]}], "+", 
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
     RowBox[{"Sum", "[", 
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"alphas", "[", 
           RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}], ")"}], "2"], 
        RowBox[{
         RowBox[{"2", "*", "i"}], "+", "1"}]], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Nx"}], "}"}]}], "]"}]}], "+", 
    RowBox[{"g", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"h", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], "2"], "2"]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Xflux", "[", 
     RowBox[{"[", 
      RowBox[{"3", "+", "Nx"}], "]"}], "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
      RowBox[{"u", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
      RowBox[{"v", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
      RowBox[{"Sum", "[", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"alphas", "[", 
           RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}], 
          RowBox[{"gammas", "[", 
           RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}]}], 
         RowBox[{
          RowBox[{"2", "*", "i"}], "+", "1"}]], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Min", "[", 
           RowBox[{"Nx", ",", "Ny"}], "]"}]}], "}"}]}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<", 
     RowBox[{"Nx", "+", "1"}]}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"Xflux", "[", 
       RowBox[{"[", 
        RowBox[{"2", "+", "i"}], "]"}], "]"}], "=", 
      RowBox[{"2", "*", 
       RowBox[{"h", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
       RowBox[{"u", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
       RowBox[{"alphas", "[", 
        RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}]}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<", 
     RowBox[{"Ny", "+", "1"}]}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"Xflux", "[", 
       RowBox[{"[", 
        RowBox[{"3", "+", "Nx", "+", "i"}], "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"h", "[", 
         RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
        RowBox[{"u", "[", 
         RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
        RowBox[{"gammas", "[", 
         RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"h", "[", 
         RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
        RowBox[{"v", "[", 
         RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
        RowBox[{"alphas", "[", 
         RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}]}]}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Yflux", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"h", "[", 
