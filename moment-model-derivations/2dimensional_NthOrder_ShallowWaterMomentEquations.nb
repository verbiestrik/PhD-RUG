Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"consvars", "[", 
    RowBox[{"t", ",", "x", ",", "y"}], "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
      RowBox[{"u", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
