Cell[BoxData["\<\"S_inv[0][0] = 1\\nS_inv[0][1] = 0\\nS_inv[0][2] = \
0\\nS_inv[1][0] = 0\\nS_inv[1][1] = (h**3*self.slip_length + 3*h*delta_t*(h + \
4*self.slip_length)*self.viscosity)/(h**3*self.slip_length + 4*h*delta_t*(h + \
3*self.slip_length)*self.viscosity + \
12*delta_t**2*self.viscosity**2)\\nS_inv[1][2] = \
-((h**2*delta_t*self.viscosity)/(h**3*self.slip_length + 4*h*delta_t*(h + \
3*self.slip_length)*self.viscosity + \
12*delta_t**2*self.viscosity**2))\\nS_inv[2][0] = 0\\nS_inv[2][1] = \
(-3*h**2*delta_t*self.viscosity)/(h**3*self.slip_length + 4*h*delta_t*(h + \
3*self.slip_length)*self.viscosity + \
12*delta_t**2*self.viscosity**2)\\nS_inv[2][2] = (h**2*(h*self.slip_length + \
delta_t*self.viscosity))/(h**3*self.slip_length + 4*h*delta_t*(h + \
3*self.slip_length)*self.viscosity + \
12*delta_t**2*self.viscosity**2)))\"\>"], "Output",
