     RowBox[{"XSystemMatrix", ",", "\[Lambda]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polyScaled", "[", "\[Lambda]_", "]"}], "=", "\[IndentingNewLine]", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"g", " ", 
            RowBox[{"h", "[", 
             RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], ")"}], "2"]], 
        RowBox[{"poly", "[", "\[Lambda]", "]"}]}], " ", "/.", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "\[Rule]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Lambda]", "  ", 
             SqrtBox[
              RowBox[{"g", " ", 
               RowBox[{"h", "[", 
                RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]]}], "+", 
            RowBox[{"u", "[", 
             RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], ")"}]}], ",", "  ", 
         RowBox[{
          RowBox[{"alpha1", "[", 
