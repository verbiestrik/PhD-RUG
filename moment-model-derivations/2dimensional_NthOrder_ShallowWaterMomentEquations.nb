     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", "i"}], "+", "1"}], ")"}], "*", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"LegendreP", "[", 
            RowBox[{"i", ",", 
             RowBox[{
              RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ",", "x"}], "]"}],
          "*", 
