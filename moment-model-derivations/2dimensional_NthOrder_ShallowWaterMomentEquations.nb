Cell[BoxData["\<\"S_inv[0][0] = 1\\nS_inv[0][1] = 0\\nS_inv[0][2] = \
0\\nS_inv[0][3] = 0\\nS_inv[0][4] = 0\\nS_inv[1][0] = 0\\nS_inv[1][1] = \
