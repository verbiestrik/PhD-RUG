Cell[CellGroupData[{

Cell["\<\
Source term vector in bottom-at-rest equilibrium for no-slip limit\
\>", "Subsubsection",
 CellChangeTimes->{{3.8585227478925686`*^9, 
  3.8585227685276165`*^9}},ExpressionUUID->"0518287c-e590-4f01-8e97-\
