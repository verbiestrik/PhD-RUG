(3*gammas[2])/7.;\\nJacobianTheta(7,8)=(4*gammas[1])/7. + \
gammas[3]/3.;\\nJacobianTheta(8,0)=-2*utheta*gammas[3] - \
(2*gammas[2]*(9*gammas[1] + \
4*gammas[3]))/15.;\\nJacobianTheta(8,1)=0;\\nJacobianTheta(8,2)=0;\\\
