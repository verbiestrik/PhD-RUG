Cell[BoxData[{
 RowBox[{
  RowBox[{"ACoefficients", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", "i"}], "+", "1"}], ")"}], "*", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"LegendreP", "[", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"LegendreP", "[", 
           RowBox[{"j", ",", 
            RowBox[{
             RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"LegendreP", "[", 
           RowBox[{"k", ",", 
            RowBox[{
             RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Nr", ",", "N\[Theta]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Nr", ",", "N\[Theta]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Nr", ",", "N\[Theta]"}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BCoefficients", "=", 
   RowBox[{"Table", "[", 
