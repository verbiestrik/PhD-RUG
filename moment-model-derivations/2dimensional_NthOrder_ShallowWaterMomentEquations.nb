  3.951909762463707*^9}},ExpressionUUID->"bf9016d1-cb93-214b-b07b-\
cdad63e7dd8f"],

Cell[TextData[StyleBox["Compute characteristic polynomial (setting \[Beta]2 \
to zero gives XSystemMatrix, setting \[Beta]1 to zero gives YSystemMatrix)",
 FontSlant->"Italic"]], "Text",
 CellChangeTimes->{{3.951909618892666*^9, 3.9519096261423416`*^9}, {
  3.9519096665510635`*^9, 
  3.951909709744524*^9}},ExpressionUUID->"5c629604-5990-dc47-a66e-\
dae9bdb2dd9a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CharPol", "[", "\[Lambda]_", "]"}], "=", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Expand", "[", 
       RowBox[{"CharacteristicPolynomial", "[", 
        RowBox[{"SystemMatrix", ",", "\[Lambda]"}], "]"}], "]"}], "]"}], "/.",
      " ", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Beta]1", "2"], " ", "+", 
       SuperscriptBox["\[Beta]2", "2"]}], "->", "1"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Adapt", " ", "the", " ", "scaling", " ", "of", " ", "the", " ", 
    "coefficients"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CharPol2", "[", "\[Lambda]_", "]"}], "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"CharPol", "[", "\[Lambda]", "]"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"g", "*", 
            RowBox[{"h", "[", 
             RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], ")"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Nx", "+", "Ny", "+", "3"}], ")"}], "/", "2"}]]], " ", "/.", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"\[Lambda]", " ", "\[Rule]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Sqrt", "[", 
               RowBox[{"g", "*", 
                RowBox[{"h", "[", 
                 RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "]"}], "*", 
              "\[Lambda]"}], " ", "+", 
             RowBox[{"\[Beta]1", "*", 
              RowBox[{"u", "[", 
               RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "+", 
             RowBox[{"\[Beta]2", "*", 
              RowBox[{"v", "[", 
               RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}], ")"}]}], ",", 
          RowBox[{
           RowBox[{"alphas", "[", 
            RowBox[{"1", ",", "t", ",", "x", ",", "y"}], "]"}], "->", 
           RowBox[{
            RowBox[{"alphas", "[", 
             RowBox[{"1", ",", "t", ",", "x", ",", "y"}], "]"}], "*", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"g", "*", 
              RowBox[{"h", "[", 
               RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"alphas", "[", 
            RowBox[{"2", ",", "t", ",", "x", ",", "y"}], "]"}], "->", 
           RowBox[{
            RowBox[{"alphas", "[", 
             RowBox[{"2", ",", "t", ",", "x", ",", "y"}], "]"}], "*", 
