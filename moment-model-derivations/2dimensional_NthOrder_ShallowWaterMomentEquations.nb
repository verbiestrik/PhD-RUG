           SqrtBox[
            RowBox[{"g", " ", 
             RowBox[{"h", "[", 
              RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]]}]}]}], "  ", 
        "}"}]}], "]"}], ",", "\[Lambda]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], ":=", 
    RowBox[{"polyScaled", "[", "\[Lambda]", "]"}]}], 
