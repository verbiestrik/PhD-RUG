Cell[BoxData["\<\"S[0] = 0\\nS[1] = -((self.viscosity*(um + alpha1 + alpha2 + \
alpha3 + alpha4))/self.slip_length)\\nS[2] = (-3*self.viscosity*(um + alpha2 \
+ alpha3 + ((h + 4*self.slip_length)*alpha1 + 4*self.slip_length*alpha3)/h + \
alpha4))/self.slip_length\\nS[3] = (-5*self.viscosity*(um + alpha1 + alpha3 + \
alpha4 + ((h + 12*self.slip_length)*alpha2 + \
12*self.slip_length*alpha4)/h))/self.slip_length\\nS[4] = \
(-7*self.viscosity*(um + alpha2 + alpha3 + ((h + 4*self.slip_length)*alpha1 + \
24*self.slip_length*alpha3)/h + alpha4))/self.slip_length\\nS[5] = \
(-9*self.viscosity*(um + alpha1 + alpha3 + alpha4 + ((h + \
12*self.slip_length)*alpha2 + \
40*self.slip_length*alpha4)/h))/self.slip_length))\"\>"], "Output",
