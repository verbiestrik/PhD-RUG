Cell[CellGroupData[{

Cell["Hyperbolicity plot for the (3,0)th order system", "Subsection",
 CellChangeTimes->{{3.848936941126545*^9, 
  3.8489369571957054`*^9}},ExpressionUUID->"1e508abd-318a-415a-8681-\
d808813fd2f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], ":=", 
   RowBox[{
    RowBox[{"CharPol2", "[", "\[Lambda]", "]"}], "/.", 
    RowBox[{
     RowBox[{"alphas", "[", 
      RowBox[{"2", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "->", 
     "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EVs", "[", 
    RowBox[{"alpha1_", ",", "alpha3_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], "\[Equal]", "0"}], ",", 
      "\[Lambda]"}], "]"}], " ", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"1", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "\[Rule]", 
       "alpha1"}], ",", 
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"3", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "->", 
       "alpha3"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ImaginaryPartofEV", "[", 
    RowBox[{"alpha1_", ",", "alpha3_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Im", "[", "\[Lambda]", "]"}], "   ", "/.", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], "\[Equal]", "0"}], ",", 
       "\[Lambda]"}], "]"}]}], " ", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"1", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "\[Rule]", 
       "alpha1"}], ",", 
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"3", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "\[Rule]", 
       "alpha3"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HypTest", "[", 
    RowBox[{"alpha1_", ",", "alpha3_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"HypTest", "[", 
     RowBox[{"alpha1", ",", "alpha3"}], "]"}], "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Chop", "[", 
        RowBox[{"Norm", "[", 
         RowBox[{"Chop", "[", 
          RowBox[{"N", "[", 
           RowBox[{"Chop", "[", 
            RowBox[{"ImaginaryPartofEV", "[", 
             RowBox[{"alpha1", ",", "alpha3"}], "]"}], "]"}], "]"}], "]"}], 
         "]"}], "]"}], "\[Equal]", "0"}], ",", "0", ",", "10"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"HypRegion", " ", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"HypTest", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"PlotPoints", "\[Rule]", "10"}], ",", 
     RowBox[{"MaxRecursion", "\[Rule]", "2"}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", 
      RowBox[{"0.25", "/", "0.4"}]}], ",", 
     RowBox[{"ColorFunction", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#1", "<", 
           RowBox[{"1", "/", "2"}]}], ",", "White", " ", ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"1.0", ",", "0.0", ",", "0.0"}], "]"}]}], "]"}], "&"}], 
       ")"}]}], ",", 
     RowBox[{"Frame", "\[Rule]", "False"}], ",", 
     RowBox[{"Axes", "\[Rule]", "True"}], ",", 
     RowBox[{"AxesOrigin", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Ticks", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.2"}], ",", 
            RowBox[{"-", "0.1"}], ",", "0.0", ",", "0.1", ",", "0.2"}], "}"}],
           ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.2"}], ",", 
            RowBox[{"-", "0.1"}], ",", "0.0", ",", "0.1", ",", "0.2"}], 
           "}"}]}], "}"}]}], ","}], "*)"}], 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"alpha1", "/", 
           SqrtBox["gh"]}], ",", "Small", ",", "Bold"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"alpha3", "/", 
           SqrtBox["gh"]}], ",", "Small", ",", "Bold"}], "]"}]}], "}"}]}], 
     ",", 
     RowBox[{"AxesStyle", "\[Rule]", "Thick"}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Bold", ",", "Medium"}], "}"}]}]}], "]"}]}],
  FontWeight->"Bold"]}], "Input",
 CellChangeTimes->{{3.848936991571023*^9, 3.848937019613908*^9}, {
  3.848937063819249*^9, 3.848937111000567*^9}},
