Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"alphas", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}], "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Nx"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gammas", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}], "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"gammas", "[", 
        RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Ny"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"Nx", "<", "Ny"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"Nx", "+", "1"}]}], ",", 
       RowBox[{"i", "<", 
        RowBox[{"Ny", "+", "1"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{
        RowBox[{"alphas", "[", 
         RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}], "=", "0"}]}], 
      "]"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"Ny", "+", "1"}]}], ",", 
       RowBox[{"i", "<", 
        RowBox[{"Nx", "+", "1"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{
        RowBox[{"gammas", "[", 
         RowBox[{"i", ",", "t", ",", "x", ",", "y"}], "]"}], "=", "0"}]}], 
      "]"}]}], "\[IndentingNewLine]", "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
