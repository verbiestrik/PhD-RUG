Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sourceTermEq3", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"3", "+", "Nx", "+", "Ny"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CCoefficients", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"LegendreP", "[", 
            RowBox[{"i", ",", 
             RowBox[{
              RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ",", "x"}], "]"}],
          "*", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"LegendreP", "[", 
            RowBox[{"j", ",", 
             RowBox[{
              RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ",", "x"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Max", "[", 
         RowBox[{"Nx", ",", "Ny"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Max", "[", 
         RowBox[{"Nx", ",", "Ny"}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sourceTermEq3", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sourceTermEq3", "[", 
    RowBox[{"[", "2", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["\[Nu]", "\[Lambda]"]}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], "+", 
      RowBox[{"Sum", "[", 
