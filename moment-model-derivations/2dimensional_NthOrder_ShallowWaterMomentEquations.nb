Cell[BoxData["\<\"sourceTerm(0)=0;\\nsourceTerm(1)=-((R*(ur + alphas[1]))/xi) \
+ (h*(pow(utheta,2) + \
pow(gammas[1],2)/3.))/coords(0);\\nsourceTerm(2)=(-3*R*(ur + (1 + \
(4*xi)/h)*alphas[1]))/xi + (h*(-(ur*alphas[1]) + \
2*utheta*gammas[1]))/coords(0);\\nsourceTerm(3)=-((R*(utheta + \
gammas[1]))/xi) - (h*(3*ur*utheta + \
alphas[1]*gammas[1]))/(3.*coords(0));\\nsourceTerm(4)=-((h*(utheta*alphas[1] \
+ ur*gammas[1]))/coords(0)) - (3*R*(utheta + (1 + \
(4*xi)/h)*gammas[1]))/xi))\"\>"], "Output",
 CellChangeTimes->{
  3.879325917224347*^9, 3.879326349842931*^9, {3.879326877151698*^9, 
   3.879326886912605*^9}, 3.9079321242883563`*^9, 3.90793221173005*^9, {
