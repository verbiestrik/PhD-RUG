     RowBox[{"alphas", "[", 
      RowBox[{"2", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "->", 
     "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EVs", "[", 
    RowBox[{"alpha1_", ",", "alpha3_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], "\[Equal]", "0"}], ",", 
      "\[Lambda]"}], "]"}], " ", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"1", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "\[Rule]", 
       "alpha1"}], ",", 
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"3", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "->", 
       "alpha3"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
