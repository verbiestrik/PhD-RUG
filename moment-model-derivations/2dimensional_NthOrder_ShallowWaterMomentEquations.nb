     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{
        RowBox[{"CharPol", "[", "\[Lambda]", "]"}], " ", "/.", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"\[Lambda]", " ", "\[Rule]", 
           RowBox[{"(", 
            RowBox[{"\[Lambda]", " ", "+", 
             RowBox[{"vr", "[", 
              RowBox[{"t", ",", "r", ",", "\[Theta]"}], "]"}]}], ")"}]}], ",", 
