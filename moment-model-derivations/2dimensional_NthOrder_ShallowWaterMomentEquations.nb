Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], ":=", 
   RowBox[{
    RowBox[{"CharPol2", "[", "\[Lambda]", "]"}], "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"2", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "->", " ", 
       "0"}], ",", " ", 
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"3", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "->", 
       "0"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EVs", "[", 
    RowBox[{"alpha1_", ",", "alpha4_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], "\[Equal]", "0"}], ",", 
      "\[Lambda]"}], "]"}], " ", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"1", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "\[Rule]", 
       "alpha1"}], ",", 
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"4", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "->", 
       "alpha4"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ImaginaryPartofEV", "[", 
    RowBox[{"alpha1_", ",", "alpha4_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Im", "[", "\[Lambda]", "]"}], "   ", "/.", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pHypTest", "[", "\[Lambda]", "]"}], "\[Equal]", "0"}], ",", 
       "\[Lambda]"}], "]"}]}], " ", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"alphas", "[", 
        RowBox[{"1", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}], "\[Rule]", 
       "alpha1"}], ",", 
      RowBox[{
       RowBox[{"alphas", "[", 
