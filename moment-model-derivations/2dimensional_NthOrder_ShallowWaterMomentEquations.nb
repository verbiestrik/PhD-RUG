           RowBox[{"(", 
            RowBox[{"5", "*", 
             RowBox[{"alphas", "[", 
              RowBox[{"2", ",", "t", ",", "r", ",", "\[Theta]"}], "]"}]}], 
            ")"}]}]}], "}"}]}], "]"}], ",", "\[Lambda]"}], "]"}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
