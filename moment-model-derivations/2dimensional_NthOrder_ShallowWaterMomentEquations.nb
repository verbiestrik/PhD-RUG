 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CharPol2", "[", "\[Lambda]_", "]"}], "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"CharPol", "[", "\[Lambda]", "]"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"g", "*", 
            RowBox[{"h", "[", 
             RowBox[{"t", ",", "r", ",", "\[Theta]"}], "]"}]}], ")"}], 
