Cell[BoxData["\<\"JacobianTheta(0,0)=0;\\nJacobianTheta(0,1)=0;\\\
nJacobianTheta(0,2)=0;\\nJacobianTheta(0,3)=0;\\nJacobianTheta(0,4)=1;\\\
nJacobianTheta(0,5)=0;\\nJacobianTheta(0,6)=0;\\nJacobianTheta(1,0)=-(ur*\
utheta) - (alphas[1]*gammas[1])/3. - \
(alphas[2]*gammas[2])/5.;\\nJacobianTheta(1,1)=utheta;\\nJacobianTheta(1,2)=\
gammas[1]/3.;\\nJacobianTheta(1,3)=gammas[2]/5.;\\nJacobianTheta(1,4)=ur;\\\
nJacobianTheta(1,5)=alphas[1]/3.;\\nJacobianTheta(1,6)=alphas[2]/5.;\\\
nJacobianTheta(2,0)=(-((5*ur + 2*alphas[2])*gammas[1]) - alphas[1]*(5*utheta \
+ 2*gammas[2]))/5.;\\nJacobianTheta(2,1)=gammas[1];\\nJacobianTheta(2,2)=\
utheta + (2*gammas[2])/5.;\\nJacobianTheta(2,3)=(2*gammas[1])/5.;\\\
nJacobianTheta(2,4)=alphas[1];\\nJacobianTheta(2,5)=(3*alphas[2])/5.;\\\
nJacobianTheta(2,6)=alphas[1]/5.;\\nJacobianTheta(3,0)=(-2*alphas[1]*gammas[1]\
)/3. - ur*gammas[2] - (alphas[2]*(7*utheta + \
2*gammas[2]))/7.;\\nJacobianTheta(3,1)=gammas[2];\\nJacobianTheta(3,2)=(2*\
gammas[1])/3.;\\nJacobianTheta(3,3)=utheta + \
(2*gammas[2])/7.;\\nJacobianTheta(3,4)=alphas[2];\\nJacobianTheta(3,5)=-0.\
3333333333333333*alphas[1];\\nJacobianTheta(3,6)=alphas[2]/7.;\\\
nJacobianTheta(4,0)=g*h - pow(utheta,2) - pow(gammas[1],2)/3. - \
pow(gammas[2],2)/5.;\\nJacobianTheta(4,1)=0;\\nJacobianTheta(4,2)=0;\\\
nJacobianTheta(4,3)=0;\\nJacobianTheta(4,4)=2*utheta;\\nJacobianTheta(4,5)=(2*\
gammas[1])/3.;\\nJacobianTheta(4,6)=(2*gammas[2])/5.;\\nJacobianTheta(5,0)=(-\
2*gammas[1]*(5*utheta + \
2*gammas[2]))/5.;\\nJacobianTheta(5,1)=0;\\nJacobianTheta(5,2)=0;\\\
nJacobianTheta(5,3)=0;\\nJacobianTheta(5,4)=2*gammas[1];\\nJacobianTheta(5,5)=\
utheta + gammas[2];\\nJacobianTheta(5,6)=(3*gammas[1])/5.;\\nJacobianTheta(6,\
0)=(-2*(7*pow(gammas[1],2) + 3*gammas[2]*(7*utheta + \
gammas[2])))/21.;\\nJacobianTheta(6,1)=0;\\nJacobianTheta(6,2)=0;\\\
nJacobianTheta(6,3)=0;\\nJacobianTheta(6,4)=2*gammas[2];\\nJacobianTheta(6,5)=\
gammas[1]/3.;\\nJacobianTheta(6,6)=utheta + (3*gammas[2])/7.))\"\>"], "Output",
